# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=forgejo

# ── Forgejo server ────────────────────────────────────────────────────────────
# Change to your LAN IP or domain name
FORGEJO_DOMAIN=git.home.local
FORGEJO_ROOT_URL=http://git.home.local:3000

# Ports exposed on the host
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

# ── Actions runner ────────────────────────────────────────────────────────────
# Leave RUNNER_TOKEN empty on first boot.
# After completing the web installer:
#   Admin → Actions → Runners → Create new runner → copy the token here
#   Then: docker compose restart runner
RUNNER_TOKEN=
RUNNER_NAME=homelab-runner

# Internal URL the runner uses to reach Forgejo (inside Docker network)
FORGEJO_RUNNER_URL=http://forgejo:3000